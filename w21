#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

################################################################################
# WATCH.21 — Scope-first Security Reconnaissance Orchestrator
#
# Authorized security testing and bug-bounty reconnaissance tool for assets
# owned by the user or explicitly authorized programs.
#
# Current alpha features:
# - 26 staged reconnaissance phases
# - HackerOne API integration (read-only)
# - Scope enforcement and normalization
# - Long-running execution with resume capability
# - Comprehensive logging and reporting
# - Safe defaults with explicit opt-in for risky operations
#
# Usage:
#   ./w21 --target domain.com --profile safe --output results/
#   ./w21 --h1-program HANDLE --scope-source hackerone --output results/
#   ./w21 --help
#
################################################################################

# ============================================================================
# CONSTANTS AND CONFIGURATION
# ============================================================================

readonly SCRIPT_NAME="w21"
readonly SCRIPT_VERSION="0.1.0-alpha"
# Resolve the real file so an installation symlink in ~/.local/bin still finds
# the adjacent lib/ directory and dependency lock in ~/.local/share/w21.
readonly SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Dependency management is isolated from reconnaissance so installation can
# never accidentally start a scan.
# shellcheck source=lib/dependency-installer.sh
source "${SCRIPT_DIR}/lib/dependency-installer.sh"

# Exit codes
readonly EXIT_SUCCESS=0
readonly EXIT_USAGE_ERROR=1
readonly EXIT_PARTIAL_COMPLETION=2
readonly EXIT_SCOPE_REJECTION=3
readonly EXIT_MISSING_DEPENDENCY=4
readonly EXIT_SCOPE_CHANGED=5
readonly EXIT_AUTH_ERROR=6
readonly EXIT_RESOURCE_LIMIT=7

# Phase states
readonly PHASE_PENDING="pending"
readonly PHASE_RUNNING="running"
readonly PHASE_SUCCESS="success"
readonly PHASE_PARTIAL="partial"
readonly PHASE_FAILED="failed"
readonly PHASE_SKIPPED="skipped"
readonly PHASE_INTERRUPTED="interrupted"

# ============================================================================
# COLOR CODES
# ============================================================================

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
NC='\033[0m'  # No Color

# ============================================================================
# GLOBAL CONFIGURATION VARIABLES
# ============================================================================

# Command-line options
TARGETS=()
TARGETS_FILE=""
SCOPE_FILE=""
SCOPE_SOURCE="file"  # file or hackerone
H1_PROGRAM=""
H1_CREDENTIALS_FILE=""
H1_REFRESH_MINUTES=60
BOUNTY_ONLY=0
PROFILE="safe"  # safe or standard
OUTPUT_DIR=""
SECLISTS_DIR=""
WORDLIST_FILE=""
ARTIFACT_URLS_FILE=""
CONFIG_FILE=""
RATE_LIMIT=50
CONCURRENCY=10
TIMEOUT=30
MAX_RUNTIME_MINUTES=10080  # 7 days default
MAX_REQUESTS=100000
MAX_FEEDBACK_ROUNDS=5
MAX_ARTIFACT_SIZE=$((100 * 1024 * 1024))  # 100 MB
RESUME=0
FORCE_PHASE=""
SKIP_PHASES=()
UPDATE_TEMPLATES=0
DRY_RUN=0
DOCTOR_MODE=0
DOCTOR_JSON=0
DEPENDENCY_ACTION=""
