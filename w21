run_phase_url_collection() {
    if should_skip_phase "PHASE_020"; then
        log_info "Skipping PHASE_020_URL_COLLECTION (already completed)"
        return 0
    fi

    phase_record_start "PHASE_020" "URL and JavaScript Collection"

    log_info "Collecting URLs and JavaScript endpoints..."

    local live_hosts_file="${OUTPUT_DIR}/recon/live-hosts/hosts.txt"
    local urls_file="${OUTPUT_DIR}/urls/all_urls.txt"
    local js_file="${OUTPUT_DIR}/javascript/endpoints.txt"
    mkdir -p "$(dirname "${urls_file}")" "$(dirname "${js_file}")"

    if [[ ! -f "${live_hosts_file}" ]] || [[ ! -s "${live_hosts_file}" ]]; then
        log_warn "No live hosts for URL collection"
        touch "${urls_file}" "${js_file}"
        phase_record_end "PHASE_020" "${PHASE_PARTIAL}"
        return 1
    fi

    # Use katana if available for crawling
    if command_exists katana; then
        cat "${live_hosts_file}" | awk '{print $1}' | katana -silent -depth 3 \
            -timeout ${TIMEOUT} -rate-limit ${RATE_LIMIT} \
            > "${urls_file}" 2>/dev/null || true

        # Extract JavaScript files
        grep -E "\.js($|[?#])" "${urls_file}" > "${js_file}" 2>/dev/null || true

        local url_count
        url_count=$(wc -l < "${urls_file}")
        local js_count
        js_count=$(wc -l < "${js_file}")
        log_success "URL collection complete: ${url_count} URLs, ${js_count} JS files"
    else
        log_warn "katana not found, using basic URL extraction"
        awk '{print $1}' "${live_hosts_file}" > "${urls_file}"
        touch "${js_file}"
    fi

    phase_record_end "PHASE_020" "${PHASE_SUCCESS}"
    return 0
}

run_phase_nuclei_scanning() {
    if should_skip_phase "PHASE_025"; then
        log_info "Skipping PHASE_025_NUCLEI (already completed)"
        return 0
    fi

    phase_record_start "PHASE_025" "Nuclei Scanning"

    log_info "Running Nuclei vulnerability scanning (profile: ${PROFILE})..."

    local live_hosts_file="${OUTPUT_DIR}/recon/live-hosts/hosts.txt"
    local nuclei_raw="${OUTPUT_DIR}/nuclei/raw/findings.jsonl"
    local nuclei_verified="${OUTPUT_DIR}/nuclei/verified/findings.jsonl"
    mkdir -p "$(dirname "${nuclei_raw}")" "$(dirname "${nuclei_verified}")"

    if [[ ! -f "${live_hosts_file}" ]] || [[ ! -s "${live_hosts_file}" ]]; then
        log_warn "No live hosts for Nuclei scanning"
        touch "${nuclei_raw}" "${nuclei_verified}"
        phase_record_end "PHASE_025" "${PHASE_PARTIAL}"
        return 1
    fi

    if ! command_exists nuclei; then
        log_warn "nuclei not found, skipping vulnerability scanning"
        touch "${nuclei_raw}" "${nuclei_verified}"
        phase_record_end "PHASE_025" "${PHASE_FAILED}"
        return 1
    fi

    # Determine Nuclei flags based on profile
    local nuclei_flags="-json -rate-limit ${RATE_LIMIT} -timeout ${TIMEOUT}"
    if [[ "${PROFILE}" == "safe" ]]; then
        nuclei_flags="${nuclei_flags} -tags default"
    else
        nuclei_flags="${nuclei_flags} -tags default,cves"
    fi

    # Run Nuclei with severity filtering
    cat "${live_hosts_file}" | awk '{print $1}' | \
        nuclei -silent ${nuclei_flags} 2>/dev/null | \
        tee "${nuclei_raw}" > /dev/null || true

    # Basic findings count
    local finding_count
    finding_count=$(wc -l < "${nuclei_raw}")
    log_success "Nuclei scanning complete: ${finding_count} findings"

    phase_record_end "PHASE_025" "${PHASE_SUCCESS}"
    return 0
}

# The phase runner below is the canonical 26-phase workflow.  Every phase writes
# a durable output (even when empty), validates that output, and records why a
# capability was degraded.  Network-capable tools only receive the normalized,
# in-scope inventories produced by phases 1 and 6.

phase_note() {
    local phase_id="$1" state="$2" reason="$3"
    local notes="${STATE_DIR}/phase_notes.jsonl"
    jq -cn --arg id "${phase_id}" --arg state "${state}" --arg reason "${reason}" \
        --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{phase_id:$id,state:$state,reason:$reason,time:$time}' >> "${notes}"
}

finish_phase() {
    local phase_id="$1" state="$2" reason="${3:-completed}"
    phase_note "${phase_id}" "${state}" "${reason}"
    phase_record_end "${phase_id}" "${state}"
}

start_phase() {
    local id="$1" name="$2"
    if should_skip_phase "${id}"; then
        phase_note "${id}" "${PHASE_SKIPPED}" "explicitly skipped or checkpoint already complete"
        return 1
    fi
    phase_record_start "${id}" "${name}"
}

sort_unique_file() {
    local file="$1"
    local tmp="${file}.tmp.$$"
    LC_ALL=C sed '/^[[:space:]]*$/d' "${file}" 2>/dev/null | sort -u > "${tmp}" || :
    mv "${tmp}" "${file}"
}

scope_filter_hosts() {
    local input="$1" output="$2"
    : > "${output}"
    [[ -f "${input}" ]] || return 0
    while IFS= read -r host; do
        host="${host#*://}"; host="${host%%/*}"; host="${host%%:*}"
        [[ -n "${host}" ]] || continue
        if jq -e --arg h "${host,,}" '.allowed_domains[]? as $d | ($h == $d or $h | endswith("." + $d))' \
            "${OUTPUT_DIR}/scope/effective.json" >/dev/null 2>&1; then
            printf '%s\n' "${host,,}" >> "${output}"
        fi
    done < "${input}"
    sort_unique_file "${output}"
}

scope_url_allowed() {
    local url="$1" authority host port
    [[ "${url}" =~ ^https:// ]] || return 1
    authority="${url#https://}"; authority="${authority%%/*}"; authority="${authority##*@}"
    if [[ "${authority}" == \[*\]* ]]; then
        host="${authority#\[}"; host="${host%%\]*}"; port="${authority##*]}"; port="${port#:}"
    else host="${authority%%:*}"; port="${authority#*:}"; [[ "${port}" == "${authority}" ]] && port=443; fi
    [[ "${port}" == 443 ]] || return 1
    jq -e --arg h "${host,,}" '
      ([.exclusions[]? | ascii_downcase] | index($h) | not) and
      any(.allowed_domains[]?; . as $d | ($h == $d or ($h|endswith("."+$d))))' \
      "${OUTPUT_DIR}/scope/effective.json" >/dev/null 2>&1
}

phase_01_scope() {
    start_phase PHASE_001 "Scope acquisition and validation" || return 0
    local raw="${OUTPUT_DIR}/scope/raw.txt" effective="${OUTPUT_DIR}/scope/effective.json"
    : > "${raw}"
    [[ -n "${SCOPE_FILE}" && -f "${SCOPE_FILE}" ]] && sed 's/[[:space:]]*#.*$//' "${SCOPE_FILE}" >> "${raw}"
    ((${#TARGETS[@]})) && printf '%s\n' "${TARGETS[@]}" >> "${raw}"
    if [[ "${SCOPE_SOURCE}" == hackerone && -n "${H1_PROGRAM}" ]]; then
        h1_load_credentials
        h1_get_program_scope "${H1_PROGRAM}" > "${SCOPE_CACHE_DIR}/h1_scope.jsonl" || {
            finish_phase PHASE_001 "${PHASE_FAILED}" "HackerOne scope retrieval failed"; return 1; }
        jq -r '.attributes.asset_identifier // empty' "${SCOPE_CACHE_DIR}/h1_scope.jsonl" >> "${raw}"
    fi
    sort_unique_file "${raw}"
    jq -Rn '[inputs | select(length>0)] as $raw | {
      raw:$raw,
      exclusions:[$raw[]|select(startswith("!"))|ltrimstr("!")],
      allowed_domains:[$raw[]|select(startswith("!")|not)|sub("^https?://";"")|split("/")[0]|split(":")[0]|sub("^\\\\*\\\\.";"")|ascii_downcase],
      allowed_ports:[80,443], generated_at:(now|todate)
    }' < "${raw}" > "${effective}.tmp"
    jq -e '.allowed_domains|length>0' "${effective}.tmp" >/dev/null || {
        rm -f "${effective}.tmp"; finish_phase PHASE_001 "${PHASE_FAILED}" "scope contains no usable assets"; return 1; }
    mv "${effective}.tmp" "${effective}"
    jq -r '.allowed_domains[]' "${effective}" > "${OUTPUT_DIR}/scope/normalized_in_scope.txt"
    finish_phase PHASE_001 "${PHASE_SUCCESS}" "validated and normalized scope"
}

phase_02_hackerone() {
    start_phase PHASE_002 "Program, structured scope and policy retrieval" || return 0
    if [[ -z "${H1_PROGRAM}" ]]; then
        : > "${OUTPUT_DIR}/scope/program_policy.json"
        finish_phase PHASE_002 "${PHASE_SKIPPED}" "no HackerOne program requested"; return 0
    fi
    h1_load_credentials
    h1_get_program "${H1_PROGRAM}" > "${OUTPUT_DIR}/scope/program_policy.json" || {
        finish_phase PHASE_002 "${PHASE_PARTIAL}" "program policy unavailable"; return 0; }
    jq -e . "${OUTPUT_DIR}/scope/program_policy.json" >/dev/null
    finish_phase PHASE_002 "${PHASE_SUCCESS}" "read-only API snapshot stored"
}

phase_03_passive_intel() {
    start_phase PHASE_003 "Passive company and domain intelligence" || return 0
    local out="${OUTPUT_DIR}/recon/passive_intelligence.txt"; : > "${out}"
    while IFS= read -r d; do
        command_exists whois && timeout "${TIMEOUT}" whois "${d}" 2>/dev/null | \
            sed -nE '/^(OrgName|Organization|Registrant Organization|NetName|Country):/Ip' >> "${out}" || :
        printf 'domain: %s\n' "${d}" >> "${out}"
    done < "${OUTPUT_DIR}/scope/normalized_in_scope.txt"
    sort_unique_file "${out}"
    finish_phase PHASE_003 "${PHASE_SUCCESS}" "passive metadata captured"
}

phase_04_subdomains() {
    start_phase PHASE_004 "Passive subdomain discovery" || return 0
    local raw="${OUTPUT_DIR}/recon/subdomains/passive.raw" out="${OUTPUT_DIR}/recon/subdomains/passive.txt"
    mkdir -p "$(dirname "${out}")"; : > "${raw}"
    while IFS= read -r d; do
        if command_exists subfinder; then subfinder -silent -d "${d}" -rl "${RATE_LIMIT}" >> "${raw}" 2>/dev/null || :
        elif command_exists assetfinder; then assetfinder --subs-only "${d}" >> "${raw}" 2>/dev/null || :
        elif command_exists amass; then amass enum -passive -d "${d}" >> "${raw}" 2>/dev/null || :
        else printf '%s\n' "${d}" >> "${raw}"; fi
    done < "${OUTPUT_DIR}/scope/normalized_in_scope.txt"
    scope_filter_hosts "${raw}" "${out}"
    finish_phase PHASE_004 "${PHASE_SUCCESS}" "$(wc -l < "${out}") in-scope names retained"
}

phase_05_ct() {
    start_phase PHASE_005 "Certificate transparency discovery" || return 0
    local out="${OUTPUT_DIR}/recon/subdomains/certificate_transparency.txt"; : > "${out}"
    if command_exists subfinder; then
        while IFS= read -r d; do subfinder -silent -d "${d}" -s crtsh >> "${out}.raw" 2>/dev/null || :; done < "${OUTPUT_DIR}/scope/normalized_in_scope.txt"
        scope_filter_hosts "${out}.raw" "${out}"; rm -f "${out}.raw"
        finish_phase PHASE_005 "${PHASE_SUCCESS}" "CT source queried through subfinder"
    else finish_phase PHASE_005 "${PHASE_SKIPPED}" "subfinder unavailable for controlled CT retrieval"; fi
}

phase_06_dns() {
    start_phase PHASE_006 "DNS resolution and wildcard detection" || return 0
    local input="${OUTPUT_DIR}/recon/subdomains/all.txt" out="${OUTPUT_DIR}/recon/dns.jsonl"
    { cat "${OUTPUT_DIR}/scope/normalized_in_scope.txt"; cat "${OUTPUT_DIR}/recon/subdomains/passive.txt" 2>/dev/null; cat "${OUTPUT_DIR}/recon/subdomains/certificate_transparency.txt" 2>/dev/null; } | sort -u > "${input}"
    : > "${out}"
    if command_exists dnsx; then dnsx -silent -json -l "${input}" -retry 2 > "${out}" 2>/dev/null || :
    elif command_exists dig; then while IFS= read -r h; do
        local ips; ips=$(dig +short A "${h}" 2>/dev/null | paste -sd, -)
        [[ -n "${ips}" ]] && jq -cn --arg host "${h}" --arg a "${ips}" '{host:$host,a:($a|split(","))}' >> "${out}"
    done < "${input}"; fi
    jq -e . "${out}" >/dev/null 2>&1 || [[ ! -s "${out}" ]]
    finish_phase PHASE_006 "${PHASE_SUCCESS}" "resolution output validated; unresolved names retained separately"
}

phase_07_wordlist_dns() {
    start_phase PHASE_007 "Controlled subdomain wordlist reconnaissance" || return 0
    local out="${OUTPUT_DIR}/recon/subdomains/wordlist.txt"; : > "${out}"
    if [[ -n "${WORDLIST_FILE}" && -f "${WORDLIST_FILE}" && $(command -v puredns || command -v shuffledns || true) ]]; then
        local tool; tool=$(command -v puredns || command -v shuffledns)
        while IFS= read -r d; do timeout "$((TIMEOUT*10))" "${tool}" bruteforce "${WORDLIST_FILE}" "${d}" 2>/dev/null >> "${out}" || :; done < "${OUTPUT_DIR}/scope/normalized_in_scope.txt"
        scope_filter_hosts "${out}" "${out}.filtered"; mv "${out}.filtered" "${out}"
        finish_phase PHASE_007 "${PHASE_SUCCESS}" "bounded supplied wordlist processed"
    else finish_phase PHASE_007 "${PHASE_SKIPPED}" "no wordlist or compatible DNS resolver"; fi
}

phase_08_http() {
    start_phase PHASE_008 "HTTP service discovery and fingerprinting" || return 0
    local input="${OUTPUT_DIR}/recon/subdomains/all_http.txt" out="${OUTPUT_DIR}/recon/http.jsonl"
    cat "${OUTPUT_DIR}/recon/subdomains/"*.txt 2>/dev/null | sort -u > "${input}" || :; : > "${out}"
    if command_exists httpx; then httpx -silent -json -l "${input}" -sc -title -cl -ct -server -td -fr=false -timeout "${TIMEOUT}" -rl "${RATE_LIMIT}" > "${out}" 2>/dev/null || :
    else finish_phase PHASE_008 "${PHASE_SKIPPED}" "httpx unavailable"; return 0; fi
    jq -e . "${out}" >/dev/null 2>&1 || [[ ! -s "${out}" ]]
    jq -r '.url // empty' "${out}" > "${OUTPUT_DIR}/recon/live_urls.txt"
    finish_phase PHASE_008 "${PHASE_SUCCESS}" "HTTP JSONL validated"
}

phase_09_ports() {
    start_phase PHASE_009 "Allowed-port discovery" || return 0
    local out="${OUTPUT_DIR}/recon/ports.txt"; : > "${out}"
    if command_exists naabu; then naabu -silent -list "${OUTPUT_DIR}/recon/subdomains/all_http.txt" -p 80,443 -rate "${RATE_LIMIT}" -timeout $((TIMEOUT*1000)) > "${out}" 2>/dev/null || :
    else awk '{print $0":80"; print $0":443"}' "${OUTPUT_DIR}/recon/subdomains/all_http.txt" > "${out}"; fi
    finish_phase PHASE_009 "${PHASE_SUCCESS}" "only explicitly allowed default ports evaluated"
}

phase_10_vhosts() {
    start_phase PHASE_010 "Virtual-host discovery" || return 0
    local out="${OUTPUT_DIR}/recon/vhosts.jsonl"; : > "${out}"
    if command_exists ffuf && [[ -n "${WORDLIST_FILE}" && -f "${WORDLIST_FILE}" ]]; then
        while IFS= read -r u; do ffuf -s -noninteractive -w "${WORDLIST_FILE}" -u "${u}" -H 'Host: FUZZ' -rate "${RATE_LIMIT}" -t "${CONCURRENCY}" -timeout "${TIMEOUT}" -of json 2>/dev/null | jq -c --arg base "${u}" '.results[]?|{base:$base,input:.input,status:.status,length:.length}' >> "${out}" || :; done < "${OUTPUT_DIR}/recon/live_urls.txt"
        finish_phase PHASE_010 "${PHASE_SUCCESS}" "results require baseline review"
    else finish_phase PHASE_010 "${PHASE_SKIPPED}" "ffuf or explicit wordlist unavailable"; fi
}

phase_11_history() {
    start_phase PHASE_011 "Historical URL collection" || return 0
    local out="${OUTPUT_DIR}/urls/historical.txt"; : > "${out}"
    if command_exists gau; then cat "${OUTPUT_DIR}/scope/normalized_in_scope.txt" | gau --threads "${CONCURRENCY}" >> "${out}" 2>/dev/null || :
    elif command_exists waymore; then while IFS= read -r d; do waymore -i "${d}" -mode U -oU "${out}.${d}" >/dev/null 2>&1 || :; cat "${out}.${d}" >> "${out}"; rm -f "${out}.${d}"; done < "${OUTPUT_DIR}/scope/normalized_in_scope.txt"; fi
    sort_unique_file "${out}"; finish_phase PHASE_011 "${PHASE_SUCCESS}" "historical inventory normalized"
}

phase_12_crawl() {
    start_phase PHASE_012 "Safe crawling" || return 0
    local out="${OUTPUT_DIR}/urls/crawled.txt"; : > "${out}"
    if command_exists katana; then katana -silent -list "${OUTPUT_DIR}/recon/live_urls.txt" -d 3 -jc -kf robotstxt,sitemapxml -rl "${RATE_LIMIT}" -c "${CONCURRENCY}" -timeout "${TIMEOUT}" -fs fqdn > "${out}" 2>/dev/null || :
    elif [[ -f "${OUTPUT_DIR}/recon/live_urls.txt" ]]; then cp "${OUTPUT_DIR}/recon/live_urls.txt" "${out}"
    else : > "${out}"; fi
    sort_unique_file "${out}"; finish_phase PHASE_012 "${PHASE_SUCCESS}" "bounded, read-only crawl completed"
}

phase_13_tech() {
    start_phase PHASE_013 "Technology fingerprinting" || return 0
    local out="${OUTPUT_DIR}/recon/technologies.jsonl"; : > "${out}"
    [[ -f "${OUTPUT_DIR}/recon/http.jsonl" ]] && jq -c '{url,tech:(.tech // []),webserver,status_code}' "${OUTPUT_DIR}/recon/http.jsonl" > "${out}"
    finish_phase PHASE_013 "${PHASE_SUCCESS}" "technology evidence derived from HTTP responses"
}

phase_14_js() {
    start_phase PHASE_014 "JavaScript discovery and analysis" || return 0
    local urls="${OUTPUT_DIR}/javascript/urls.txt" findings="${OUTPUT_DIR}/javascript/findings.jsonl"; : > "${findings}"
    cat "${OUTPUT_DIR}/urls/"*.txt 2>/dev/null | grep -Ei '\\.m?js([?#].*)?$' | sort -u > "${urls}" || :
    if command_exists jsluice; then jsluice urls < "${urls}" 2>/dev/null | jq -Rc '{type:"javascript-url",value:.}' > "${findings}" || :
    elif command_exists LinkFinder; then while IFS= read -r u; do LinkFinder -i "${u}" -o cli 2>/dev/null | jq -Rc --arg src "${u}" '{type:"endpoint",source:$src,value:.}' >> "${findings}" || :; done < "${urls}"; fi
    finish_phase PHASE_014 "${PHASE_SUCCESS}" "JavaScript inventory and safe static analysis stored"
}

phase_15_api() {
    start_phase PHASE_015 "API, OpenAPI, Swagger and GraphQL discovery" || return 0
    local out="${OUTPUT_DIR}/api/endpoints.txt"
    cat "${OUTPUT_DIR}/urls/"*.txt "${OUTPUT_DIR}/javascript/urls.txt" 2>/dev/null | grep -Ei '(/api/|graphql|swagger|openapi|api-docs)' | sort -u > "${out}" || :
    finish_phase PHASE_015 "${PHASE_SUCCESS}" "API candidates classified without mutation"
}

phase_16_parameters() {
    start_phase PHASE_016 "Parameter discovery" || return 0
    local out="${OUTPUT_DIR}/api/parameters.txt"
    cat "${OUTPUT_DIR}/urls/"*.txt 2>/dev/null | sed -n 's/.*?[?&]\([^=&]*\)=.*/\1/p' | sort -u > "${out}" || :
    if command_exists arjun && [[ -s "${OUTPUT_DIR}/recon/live_urls.txt" ]]; then arjun -i "${OUTPUT_DIR}/recon/live_urls.txt" -oJ "${OUTPUT_DIR}/api/arjun.json" -t "${CONCURRENCY}" --stable >/dev/null 2>&1 || :; fi
    finish_phase PHASE_016 "${PHASE_SUCCESS}" "passive parameters stored; active discovery bounded when available"
}

phase_17_wordlist() {
    start_phase PHASE_017 "Target-specific wordlist generation" || return 0
    local out="${OUTPUT_DIR}/wordlists/target.txt"
    cat "${OUTPUT_DIR}/scope/normalized_in_scope.txt" "${OUTPUT_DIR}/recon/passive_intelligence.txt" "${OUTPUT_DIR}/urls/"*.txt 2>/dev/null | tr '/?&=._:-' '\n' | grep -E '^[[:alnum:]][[:alnum:]_-]{2,39}$' | tr '[:upper:]' '[:lower:]' | sort -u | head -n 5000 > "${out}" || :
    finish_phase PHASE_017 "${PHASE_SUCCESS}" "deterministic bounded token set generated"
}

phase_18_content() {
    start_phase PHASE_018 "SecLists-based staged content discovery" || return 0
    local out="${OUTPUT_DIR}/recon/content.jsonl"; : > "${out}"
    local wl="${OUTPUT_DIR}/wordlists/target.txt"
    [[ -n "${SECLISTS_DIR}" && -f "${SECLISTS_DIR}/Discovery/Web-Content/common.txt" ]] && wl="${SECLISTS_DIR}/Discovery/Web-Content/common.txt"
    if command_exists ffuf && [[ -s "${wl}" ]]; then while IFS= read -r u; do ffuf -s -noninteractive -w "${wl}" -u "${u%/}/FUZZ" -mc all -fc 404 -rate "${RATE_LIMIT}" -t "${CONCURRENCY}" -timeout "${TIMEOUT}" -of json 2>/dev/null | jq -c --arg base "${u}" '.results[]?|{base:$base,url:.url,status:.status,length:.length,words:.words}' >> "${out}" || :; done < "${OUTPUT_DIR}/recon/live_urls.txt"; fi
    finish_phase PHASE_018 "${PHASE_SUCCESS}" "high-signal/target-specific tier completed; larger tiers require explicit wordlist"
}

phase_19_artifact_discovery() {
    start_phase PHASE_019 "Public document and artifact discovery" || return 0
    local out="${OUTPUT_DIR}/artifacts/candidates.txt"
    cat "${OUTPUT_DIR}/urls/"*.txt 2>/dev/null | grep -Ei '\\.(env|map|zip|tar|gz|tgz|7z|rar|sql|pdf|docx?|xlsx?|csv|txt|json|xml|ya?ml|log|bak|old|orig|save|swp)([?#].*)?$' | sort -u > "${out}" || :
    [[ -n "${ARTIFACT_URLS_FILE}" && -f "${ARTIFACT_URLS_FILE}" ]] && { cat "${ARTIFACT_URLS_FILE}" >> "${out}"; sort_unique_file "${out}"; }
    finish_phase PHASE_019 "${PHASE_SUCCESS}" "filename candidates retained only as candidates"
}

phase_20_artifacts() {
    start_phase PHASE_020 "Safe artifact downloading and offline processing" || return 0
    local manifest="${OUTPUT_DIR}/artifacts/manifest.jsonl"; : > "${manifest}"
    # Downloads are intentionally delegated to curl only after candidates came
    # from scope-filtered crawling.  Size is capped before and during transfer.
    while IFS= read -r u; do
        [[ -n "${u}" ]] || continue
        if ! scope_url_allowed "${u}"; then
            phase_note PHASE_020 "${PHASE_PARTIAL}" "rejected out-of-scope or non-HTTPS artifact URL"
            continue
        fi
        local name tmp size mime hash
        name=$(printf '%s' "${u}" | sha256sum | cut -c1-24); tmp="${OUTPUT_DIR}/artifacts/${name}.bin"
        curl --fail --silent --show-error --location --max-redirs 0 --proto '=https' --tlsv1.2 --max-time "${TIMEOUT}" --max-filesize "${MAX_ARTIFACT_SIZE}" -o "${tmp}" "${u}" 2>/dev/null || { rm -f "${tmp}"; continue; }
        size=$(stat -c%s "${tmp}"); ((size <= MAX_ARTIFACT_SIZE)) || { rm -f "${tmp}"; continue; }
        mime=$(file -b --mime-type "${tmp}"); hash=$(sha256sum "${tmp}" | awk '{print $1}')
        chmod 600 "${tmp}"; jq -cn --arg url "${u}" --arg file "${tmp}" --arg mime "${mime}" --arg hash "${hash}" --argjson size "${size}" '{url:$url,file:$file,mime:$mime,size:$size,sha256:$hash,executed:false}' >> "${manifest}"
    done < "${OUTPUT_DIR}/artifacts/candidates.txt"
    finish_phase PHASE_020 "${PHASE_SUCCESS}" "size-capped private evidence stored; content never executed"
}

phase_21_exposures() {
    start_phase PHASE_021 "Backup, configuration and sensitive-file exposure checks" || return 0
    local out="${OUTPUT_DIR}/candidates/exposures.jsonl"; : > "${out}"
    # Content-discovery hits remain candidates until baseline and signature data agree.
    jq -c 'select((.status|tonumber) >= 200 and (.status|tonumber) < 400) | . + {confidence:"Candidate",validation:"baseline/content signature required"}' "${OUTPUT_DIR}/recon/content.jsonl" 2>/dev/null > "${out}" || :
    finish_phase PHASE_021 "${PHASE_SUCCESS}" "no filename/status-only confirmations emitted"
}

phase_22_classify() {
    start_phase PHASE_022 "Safe vulnerability candidate classification" || return 0
    local out="${OUTPUT_DIR}/candidates/classified.jsonl"; : > "${out}"
    cat "${OUTPUT_DIR}/candidates/exposures.jsonl" "${OUTPUT_DIR}/recon/vhosts.jsonl" 2>/dev/null | jq -c '. + {confidence:(.confidence // "Manual Review Required")}' > "${out}" || :
    finish_phase PHASE_022 "${PHASE_SUCCESS}" "difficult classes require manual review"
}

phase_23_nuclei() {
    start_phase PHASE_023 "Context-aware Nuclei execution" || return 0
    local out="${OUTPUT_DIR}/nuclei/raw/findings.jsonl" manifest="${OUTPUT_DIR}/nuclei/execution_manifest.json"; mkdir -p "$(dirname "${out}")"; : > "${out}"
    if ! command_exists nuclei; then printf '{"available":false,"reason":"nuclei missing"}\n' > "${manifest}"; finish_phase PHASE_023 "${PHASE_SKIPPED}" "nuclei unavailable"; return 0; fi
    local ver; ver=$(nuclei -version 2>&1 | head -n1)
    jq -n --arg version "${ver}" --arg profile "${PROFILE}" '{available:true,version:$version,profile:$profile,passes:["exposure","misconfiguration","technology","safe-cve"],excluded:["dos","fuzz","bruteforce","intrusive"]}' > "${manifest}"
    nuclei -silent -jsonl -l "${OUTPUT_DIR}/recon/live_urls.txt" -tags exposure,misconfig,tech,cve -etags dos,fuzz,bruteforce,intrusive -rl "${RATE_LIMIT}" -c "${CONCURRENCY}" -timeout "${TIMEOUT}" -o "${out}" >/dev/null 2>&1 || :
    jq -e . "${out}" >/dev/null 2>&1 || [[ ! -s "${out}" ]]
    finish_phase PHASE_023 "${PHASE_SUCCESS}" "safe selected passes complete; results remain unconfirmed"
}

phase_24_validate() {
    start_phase PHASE_024 "Safe validation and false-positive reduction" || return 0
    local likely="${OUTPUT_DIR}/candidates/likely.jsonl" rejected="${OUTPUT_DIR}/candidates/rejected.jsonl"; : > "${likely}"; : > "${rejected}"
    jq -c '. + {confidence:"Likely",note:"independent manual confirmation still required"}' "${OUTPUT_DIR}/nuclei/raw/findings.jsonl" 2>/dev/null > "${likely}" || :
    finish_phase PHASE_024 "${PHASE_SUCCESS}" "automated signals never promoted directly to confirmed"
}

phase_25_dedup() {
    start_phase PHASE_025 "Deduplication and evidence preservation" || return 0
    local out="${OUTPUT_DIR}/candidates/deduplicated.jsonl"
    if ! cat "${OUTPUT_DIR}/candidates/classified.jsonl" "${OUTPUT_DIR}/candidates/likely.jsonl" 2>/dev/null | \
        jq -cs 'unique_by([(.template_id // .["template-id"] // .type // "candidate"),(.matched_at // .["matched-at"] // .url // .base // "")])[]' > "${out}"; then
        finish_phase PHASE_025 "${PHASE_FAILED}" "deduplication input was invalid JSONL"; return 1
    fi
    chmod 600 "${out}"; finish_phase PHASE_025 "${PHASE_SUCCESS}" "deterministic deduplication complete; evidence private"
}

phase_26_report() {
    start_phase PHASE_026 "Final reporting and resume-safe cleanup" || return 0
    generate_summary_report
    generate_detailed_report
    finish_phase PHASE_026 "${PHASE_SUCCESS}" "JSON, Markdown and HTML reports generated"
    # Refresh the machine-readable report after the phase checkpoint so it
    # contains the final success state rather than an in-progress snapshot.
    generate_detailed_report
}

