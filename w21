generate_detailed_report() {
    local report_file="${OUTPUT_DIR}/report/report.json"

    log_info "Generating detailed JSON report..."

    local end_time findings assets urls artifacts
    end_time=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    findings=$(wc -l < "${OUTPUT_DIR}/candidates/deduplicated.jsonl" 2>/dev/null || echo 0)
    assets=$(wc -l < "${OUTPUT_DIR}/recon/subdomains/all_http.txt" 2>/dev/null || echo 0)
    urls=$(cat "${OUTPUT_DIR}/urls/"*.txt 2>/dev/null | sort -u | wc -l || echo 0)
    artifacts=$(wc -l < "${OUTPUT_DIR}/artifacts/manifest.jsonl" 2>/dev/null || echo 0)
    jq -n --arg id "${SCAN_ID}" --arg start "${START_TIME}" --arg end "${end_time}" \
      --arg profile "${PROFILE}" --arg source "${SCOPE_SOURCE}" --argjson tls "$((INSECURE==0))" \
      --argjson assets "${assets}" --argjson urls "${urls}" --argjson artifacts "${artifacts}" \
      --argjson findings "${findings}" --slurpfile scope "${OUTPUT_DIR}/scope/effective.json" \
      --slurpfile phases "${STATE_DIR}/phases.json" \
      '{scan_metadata:{scan_id:$id,start_time:$start,end_time:$end,profile:$profile,scope_source:$source},scope:$scope[0],tool_manifest:"../manifest.json",inventory:{assets:$assets,urls:$urls,artifacts:$artifacts},findings:{total:$findings,confidence_states:["Informational","Candidate","Likely","Confirmed-Safe","Manual Review Required","Rejected False Positive"]},phases:$phases[0].phases,security:{tls_verification:$tls,read_only:true,automatic_submission:false}}' > "${report_file}.tmp"
    mv "${report_file}.tmp" "${report_file}"

    jq -c '.' "${OUTPUT_DIR}/candidates/deduplicated.jsonl" 2>/dev/null > "${OUTPUT_DIR}/report/findings.jsonl" || :
    {
      printf '# WATCH.21 Report\n\n'
      printf 'Scan `%s` started %s with profile `%s`.\n\n' "${SCAN_ID}" "${START_TIME}" "${PROFILE}"
      printf '## Executive summary\n\nAssets: %s; URLs: %s; private artifacts: %s; deduplicated candidates: %s.\n\n' "${assets}" "${urls}" "${artifacts}" "${findings}"
      printf '## Scope and exclusions\n\n```json\n'; jq . "${OUTPUT_DIR}/scope/effective.json"; printf '\n```\n\n'
      printf '## Phase status and exact reasons\n\n| Phase | State | Reason |\n|---|---|---|\n'
      jq -r '[.phase_id,.state,.reason]|"| \(.[]) |"' "${STATE_DIR}/phase_notes.jsonl" 2>/dev/null || :
      printf '\n## Findings and confidence\n\nAutomated results are never treated as confirmed without independent safe validation. See `findings.jsonl`.\n\n'
      printf '## Evidence and remediation\n\nEvidence paths, timestamps, hashes, sanitized metadata, rejection records, and tool manifests are stored beside this report. Remediate verified exposures by removing public access, rotating affected secrets, and reviewing access logs.\n'
    } > "${OUTPUT_DIR}/report/report.md"
    sed 's/&/\&amp;/g;s/</\&lt;/g;s/>/\&gt;/g' "${OUTPUT_DIR}/report/report.md" | awk 'BEGIN{print "<!doctype html><meta charset=\"utf-8\"><title>WATCH.21 Report</title><pre>"}{print}END{print "</pre>"}' > "${OUTPUT_DIR}/report/report.html"

    log_success "Detailed report generated: ${report_file}"
}

