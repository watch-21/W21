# ============================================================================
# HACKERONE API INTEGRATION
# ============================================================================

h1_load_credentials() {
    # First try to load from file
    if [[ -n "${H1_CREDENTIALS_FILE}" && -f "${H1_CREDENTIALS_FILE}" ]]; then
        # Check file permissions (must be 600)
        local perms
        perms=$(stat -c%a "${H1_CREDENTIALS_FILE}" 2>/dev/null)
        if [[ "${perms}" != "600" ]]; then
            die "Credentials file has insecure permissions: ${perms}. Must be 600." "${EXIT_USAGE_ERROR}"
        fi

        # Source credentials
        # shellcheck disable=SC1090
        source "${H1_CREDENTIALS_FILE}"
    fi

    # Then try environment variables
    H1_USERNAME="${H1_USERNAME:-${H1_API_USERNAME:-}}"
    H1_TOKEN="${H1_TOKEN:-${H1_API_TOKEN:-}}"

    if [[ -z "${H1_USERNAME}" || -z "${H1_TOKEN}" ]]; then
        die "HackerOne credentials not found. Set H1_API_USERNAME and H1_API_TOKEN." "${EXIT_AUTH_ERROR}"
    fi

    log_info "HackerOne credentials loaded"
}

h1_api_request() {
    local endpoint="$1"
    local method="${2:-GET}"
    local temp_credentials

    temp_credentials=$(mktemp)
    chmod 600 "${temp_credentials}"
    echo "${H1_USERNAME}:${H1_TOKEN}" > "${temp_credentials}"
    trap "rm -f ${temp_credentials}" RETURN

    local response
    response=$(curl -s \
        -w "\n%{http_code}" \
        --basic \
        --user-agent "w21/1.0" \
        -u "$(cat "${temp_credentials}")" \
        -H "Accept: application/json" \
        -X "${method}" \
        "${H1_API_URL}${endpoint}" 2>/dev/null || echo "error")

    # Parse response and HTTP code
    local http_code
    http_code=$(echo "${response}" | tail -n1)
    local body
    body=$(echo "${response}" | head -n-1)

    case "${http_code}" in
        200|201)
            echo "${body}"
            return 0
            ;;
        401|403)
            log_error "Authentication failed (${http_code})"
            return "${EXIT_AUTH_ERROR}"
            ;;
        404)
            log_error "Resource not found (${http_code})"
            return 1
            ;;
        429)
            log_warn "Rate limited. Implementing backoff..."
            sleep 5
            return 1
            ;;
        5*)
            log_warn "Server error (${http_code}). Retrying..."
            sleep 2
            return 1
            ;;
        *)
            log_error "Unexpected HTTP ${http_code}"
            return 1
            ;;
    esac
}

h1_get_program() {
    local handle="$1"
    local cache_file="${API_CACHE_DIR}/program_${handle}.json"

    # Check cache first
    if [[ -f "${cache_file}" ]]; then
        cat "${cache_file}"
        return 0
    fi

    log_info "Fetching HackerOne program: ${handle}"

    local response
    if ! response=$(h1_api_request "/v1/hackers/programs/${handle}"); then
        return 1
    fi

    # Cache the response (600 permissions for security)
    echo "${response}" > "${cache_file}"
    chmod 600 "${cache_file}"

    echo "${response}"
    return 0
}

h1_get_program_scope() {
    local handle="$1"
    local cache_file="${API_CACHE_DIR}/scopes_${handle}.jsonl"

    # Check cache
    if [[ -f "${cache_file}" ]]; then
        cat "${cache_file}"
        return 0
    fi

    log_info "Fetching scope for program: ${handle}"

    local page=1
    local has_more=true

    while [[ "${has_more}" == "true" ]]; do
        local response
        if ! response=$(h1_api_request "/v1/hackers/programs/${handle}/structured_scopes?page=${page}&per_page=100"); then
            return 1
        fi

        # Extract scopes and write to cache
        echo "${response}" | jq -r '.data[] | @json' >> "${cache_file}"

        # Check for next page
        has_more=$(echo "${response}" | jq -r '.links.next != null')
        ((page++))

        # Rate limiting
        sleep 1
    done

    chmod 600 "${cache_file}"
    cat "${cache_file}"
    return 0
}

h1_get_scope_exclusions() {
    local handle="$1"
    local cache_file="${API_CACHE_DIR}/exclusions_${handle}.json"

    if [[ -f "${cache_file}" ]]; then
        cat "${cache_file}"
        return 0
    fi

    log_info "Fetching scope exclusions for program: ${handle}"

    local response
    if ! response=$(h1_api_request "/v1/hackers/programs/${handle}/scope_exclusions"); then
        return 1
    fi

    echo "${response}" > "${cache_file}"
    chmod 600 "${cache_file}"

    echo "${response}"
    return 0
}

h1_list_programs() {
    log_info "Fetching available programs..."

    local page=1
    local has_more=true

    echo -e "${CYAN}Available HackerOne Programs:${NC}\n"

    while [[ "${has_more}" == "true" ]]; do
        local response
        if ! response=$(h1_api_request "/v1/hackers/programs?page=${page}&per_page=100"); then
            break
        fi

        # Display programs
        echo "${response}" | jq -r '.data[] | "\(.handle)\t\(.name)\t\(.state)"'

        has_more=$(echo "${response}" | jq -r '.links.next != null')
        ((page++))
        sleep 1
    done
}

# ============================================================================
# SCOPE NORMALIZATION AND ENFORCEMENT
# ============================================================================

normalize_url() {
    local url="$1"

    # Remove user info
    url="${url##*://}"
    url="${url#*@}"

    # Lowercase domain
    url=$(echo "${url}" | awk -F'/' '{print tolower($1)"/"$2}')

    # Normalize path
    url=$(echo "${url}" | sed 's|//|/|g')

    echo "https://${url}"
}

is_in_scope() {
    local target="$1"
    local scope_list=("${@:2}")

    # Normalize target
    target=$(normalize_url "${target}")

    for scope_item in "${scope_list[@]}"; do
        # Exact domain match
        if [[ "${target}" == *"${scope_item}" ]]; then
            return 0
        fi

        # Wildcard domain match
        if [[ "${scope_item}" == *.* ]]; then
            local domain_pattern="${scope_item#\*.}"
            if [[ "${target}" == *"${domain_pattern}" ]]; then
                return 0
            fi
        fi
    done

    return 1
}

# ============================================================================
# PHASE MANAGEMENT
# ============================================================================

phase_record_start() {
    local phase_id="$1"
    local phase_name="$2"

    log_info "Starting phase: ${phase_name}"

    # Record phase start in state
    jq ".phases += [{\"phase_id\": \"${phase_id}\", \"name\": \"${phase_name}\", \"state\": \"${PHASE_RUNNING}\", \"start_time\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}]" \
        "${STATE_DIR}/phases.json" > "${STATE_DIR}/phases.json.tmp"
    mv "${STATE_DIR}/phases.json.tmp" "${STATE_DIR}/phases.json"
}

phase_record_end() {
    local phase_id="$1"
    local state="$2"

    log_info "Phase ${phase_id} completed with state: ${state}"

    # Update phase state
    jq "(.phases[] | select(.phase_id == \"${phase_id}\")).state = \"${state}\" | (.phases[] | select(.phase_id == \"${phase_id}\")).end_time = \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"" \
        "${STATE_DIR}/phases.json" > "${STATE_DIR}/phases.json.tmp"
    mv "${STATE_DIR}/phases.json.tmp" "${STATE_DIR}/phases.json"
}

phase_is_complete() {
    local phase_id="$1"
    jq -e ".phases[] | select(.phase_id == \"${phase_id}\" and .state == \"${PHASE_SUCCESS}\")" \
        "${STATE_DIR}/phases.json" >/dev/null 2>&1
}

should_skip_phase() {
    local phase_id="$1"

    # Check if phase is in skip list
    for skip_phase in "${SKIP_PHASES[@]}"; do
        if [[ "${skip_phase}" == "${phase_id}" ]]; then
            return 0
        fi
    done

    # Check if already completed and not forcing re-run
    if phase_is_complete "${phase_id}" && [[ "${FORCE_PHASE}" != "${phase_id}" ]]; then
        return 0
    fi

    return 1
}

# ============================================================================
# CORE PHASE IMPLEMENTATIONS
# ============================================================================

run_phase_initialization() {
    if should_skip_phase "PHASE_001"; then
        log_info "Skipping PHASE_001_INITIALIZATION (already completed)"
        return 0
    fi

    phase_record_start "PHASE_001" "Initialization"

    log_info "Initializing reconnaissance framework..."

    # Store configuration
    cat > "${STATE_DIR}/config.json" <<EOF
{
  "scan_id": "${SCAN_ID}",
  "start_time": "${START_TIME}",
  "profile": "${PROFILE}",
  "rate_limit": ${RATE_LIMIT},
  "concurrency": ${CONCURRENCY},
  "timeout": ${TIMEOUT},
  "max_runtime_minutes": ${MAX_RUNTIME_MINUTES},
  "max_requests": ${MAX_REQUESTS},
  "insecure": ${INSECURE}
}
EOF

    log_success "Configuration stored in state"
    phase_record_end "PHASE_001" "${PHASE_SUCCESS}"
    return 0
}

run_phase_dependency_check() {
    if should_skip_phase "PHASE_002"; then
        log_info "Skipping PHASE_002_DEPENDENCY_CHECK (already completed)"
        return 0
    fi

    phase_record_start "PHASE_002" "Dependency and Version Checks"

    log_info "Checking dependencies and tool versions..."

    if ! check_required_dependencies; then
        phase_record_end "PHASE_002" "${PHASE_FAILED}"
        return 1
    fi

    check_optional_dependencies

    log_success "Dependency check complete"
    phase_record_end "PHASE_002" "${PHASE_SUCCESS}"
    return 0
}

run_phase_scope_acquisition() {
    if should_skip_phase "PHASE_004"; then
        log_info "Skipping PHASE_004_SCOPE_ACQUISITION (already completed)"
        return 0
    fi

    phase_record_start "PHASE_004" "Scope Acquisition"

    log_info "Acquiring scope from ${SCOPE_SOURCE}..."

    local scope_file="${SCOPE_CACHE_DIR}/scope_snapshot.txt"

    if [[ "${SCOPE_SOURCE}" == "hackerone" && -n "${H1_PROGRAM}" ]]; then
        # Fetch HackerOne scope
        h1_load_credentials
        h1_get_program_scope "${H1_PROGRAM}" > "${scope_file}"
        log_success "HackerOne scope acquired"
    elif [[ -n "${SCOPE_FILE}" && -f "${SCOPE_FILE}" ]]; then
        cp "${SCOPE_FILE}" "${scope_file}"
        log_success "Scope file loaded"
    else
        # Use targets as scope
        printf '%s\n' "${TARGETS[@]}" > "${scope_file}"
        log_success "Target list loaded as scope"
    fi

    phase_record_end "PHASE_004" "${PHASE_SUCCESS}"
    return 0
}

run_phase_passive_subdomain_discovery() {
    if should_skip_phase "PHASE_006"; then
        log_info "Skipping PHASE_006_PASSIVE_DISCOVERY (already completed)"
        return 0
    fi

    phase_record_start "PHASE_006" "Passive Subdomain Discovery"

    log_info "Running passive subdomain enumeration..."

    local output_file="${OUTPUT_DIR}/recon/subdomains/passive.txt"
    mkdir -p "$(dirname "${output_file}")"

    # Use subfinder if available
    if command_exists subfinder; then
        printf '%s\n' "${TARGETS[@]}" | subfinder -silent > "${output_file}" 2>/dev/null || true
        log_success "Passive subdomain discovery complete: $(wc -l < "${output_file}") subdomains"
    else
        log_warn "subfinder not found, skipping passive enumeration"
        touch "${output_file}"
    fi

    phase_record_end "PHASE_006" "${PHASE_SUCCESS}"
    return 0
}

run_phase_live_probing() {
    if should_skip_phase "PHASE_009"; then
        log_info "Skipping PHASE_009_LIVE_PROBING (already completed)"
        return 0
    fi

    phase_record_start "PHASE_009" "Live Web-Service Probing"

    log_info "Probing for live hosts with httpx..."

    local subdomains_file="${OUTPUT_DIR}/recon/subdomains/passive.txt"
    local live_hosts_file="${OUTPUT_DIR}/recon/live-hosts/hosts.txt"
    mkdir -p "$(dirname "${live_hosts_file}")"

    if [[ ! -f "${subdomains_file}" ]] || [[ ! -s "${subdomains_file}" ]]; then
        log_warn "No subdomains found for probing"
        touch "${live_hosts_file}"
        phase_record_end "PHASE_009" "${PHASE_PARTIAL}"
        return 1
    fi

    if command_exists httpx; then
        cat "${subdomains_file}" | httpx -silent -status-code -title -content-length \
            -timeout ${TIMEOUT} -rate-limit ${RATE_LIMIT} \
            > "${live_hosts_file}" 2>/dev/null || true

        local count
        count=$(wc -l < "${live_hosts_file}")
        log_success "Live host probing complete: ${count} hosts found"
    else
        log_warn "httpx not found, skipping live probing"
        touch "${live_hosts_file}"
    fi

    phase_record_end "PHASE_009" "${PHASE_SUCCESS}"
    return 0
}

