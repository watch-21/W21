# ============================================================================
# MAIN EXECUTION
# ============================================================================

main() {
    # Parse before output so --doctor --json remains valid JSON.
    parse_arguments "$@"

    if [[ ${DOCTOR_MODE} -eq 1 ]]; then
        run_doctor_mode
        exit "${EXIT_SUCCESS}"
    fi
    if [[ -n "${DEPENDENCY_ACTION}" ]]; then
        W21_ASSUME_YES="${ASSUME_YES}"
        if [[ "${DEPENDENCY_ACTION}" == plan ]]; then
            W21_INSTALL_MODE=missing
            print_install_plan
        else
            W21_INSTALL_MODE="${DEPENDENCY_ACTION}"
            run_installation
        fi
        exit $?
    fi

    # Reject incomplete input before environment checks so users receive the
    # actionable usage error they need. Resume restores targets from state.
    if [[ ${RESUME} -ne 1 && ${#TARGETS[@]} -eq 0 && -z "${TARGETS_FILE}" && \
          -z "${SCOPE_FILE}" && -z "${H1_PROGRAM}" ]]; then
        die "No targets or scope specified. Use --target, --targets, --scope, or --h1-program" \
            "${EXIT_USAGE_ERROR}"
    fi

    if [[ -n "${TARGETS_FILE}" && ! -f "${TARGETS_FILE}" ]]; then
        die "Targets file not found: ${TARGETS_FILE}" "${EXIT_USAGE_ERROR}"
    fi

    if [[ -n "${SCOPE_FILE}" && ! -f "${SCOPE_FILE}" ]]; then
        die "Scope file not found: ${SCOPE_FILE}" "${EXIT_USAGE_ERROR}"
    fi

    if [[ ${EUID} -eq 0 ]]; then
        if [[ ${DRY_RUN} -eq 1 ]]; then
            log_warn "Running a no-network dry-run as root; real scans still require a normal user."
        else
            log_warn "Do not run WATCH.21 as root. Use a normal account; sudo is used only for individual apt operations."
            exit "${EXIT_USAGE_ERROR}"
        fi
    fi

    # Show banner
    cat <<'EOF'

  _  _  _        _              ____
 | || || |      | |            |  _ \ _ __ ___
 | || || | _ __ | | ___ ___| |__) | '__/ _ \
 |__   _| | '_  \| |/ _ \/ __|  ___/| | | (_) |
    | | | | | | | |  __/\__ \ | |   | |  \__, |
    |_| |_|_| |_|_|\___||___/_|_|   |_|    ___/
                                  v0.1.0-alpha

EOF

    # Check required dependencies early
    if ! check_required_dependencies; then
        die "Missing required dependencies" "${EXIT_MISSING_DEPENDENCY}"
    fi

    # Initialize output directory
    init_output_dir

    # Generate scan ID
    generate_scan_id

    # Initialize state
    init_state

    log_info "WATCH.21 v${SCRIPT_VERSION} started"
    log_info "Scan ID: ${SCAN_ID}"

    # Handle dry-run
    if [[ ${DRY_RUN} -eq 1 ]]; then
        run_dry_run
        exit "${EXIT_SUCCESS}"
    fi

    # Load targets from file if specified
    if [[ -n "${TARGETS_FILE}" ]]; then
        mapfile -t TARGETS < "${TARGETS_FILE}"
    fi

    # Run the canonical 26-phase workflow in sequence. A phase may degrade or
    # skip an unavailable optional capability, but it must always checkpoint.
    log_info "Executing reconnaissance phases..."
    log_info "Profile: ${PROFILE}"

    local phase_fn
    for phase_fn in \
        phase_01_scope phase_02_hackerone phase_03_passive_intel phase_04_subdomains \
        phase_05_ct phase_06_dns phase_07_wordlist_dns phase_08_http phase_09_ports \
        phase_10_vhosts phase_11_history phase_12_crawl phase_13_tech phase_14_js \
        phase_15_api phase_16_parameters phase_17_wordlist phase_18_content \
        phase_19_artifact_discovery phase_20_artifacts phase_21_exposures \
        phase_22_classify phase_23_nuclei phase_24_validate phase_25_dedup phase_26_report; do
        if ! "${phase_fn}"; then
            log_warn "${phase_fn} returned an error; later independent phases will continue"
        fi
    done

    log_success "Reconnaissance complete"
    log_info "Results saved to: ${OUTPUT_DIR}"
    log_info "Summary report: ${OUTPUT_DIR}/report/summary.txt"
    log_info "Detailed report: ${OUTPUT_DIR}/report/report.json"

    exit "${EXIT_SUCCESS}"
}

# ============================================================================
# ENTRY POINT
# ============================================================================

main "$@"
