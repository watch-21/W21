INSECURE=0
NON_INTERACTIVE=0

# Runtime state
SCAN_ID=""
START_TIME=""
LAST_ACTIVITY=""
OUTPUT_DIR_LOCK=""
TEMP_DIR=""
STATE_DIR=""
LOG_FILE="/dev/null"
MANIFEST_FILE=""
API_CACHE_DIR=""
SCOPE_CACHE_DIR=""

# HackerOne API state
H1_USERNAME=""
H1_TOKEN=""
H1_API_URL="https://api.hackerone.com"
H1_PROGRAM_DATA=""
H1_SCOPES=()
H1_SCOPE_EXCLUSIONS=()

# Scope state
SCOPE_NORMALIZED=()
SUBMISSION_ELIGIBLE=()
BOUNTY_ELIGIBLE=()
OUT_OF_SCOPE_ITEMS=()
AMBIGUOUS_SCOPE_ITEMS=()

# ============================================================================
# LOGGING FUNCTIONS
# ============================================================================

log_info() {
    local msg="$1"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo -e "${CYAN}[${timestamp}]${NC} ${GREEN}[*]${NC} ${msg}" | tee -a "${LOG_FILE}"
}

log_warn() {
    local msg="$1"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo -e "${CYAN}[${timestamp}]${NC} ${YELLOW}[!]${NC} ${msg}" | tee -a "${LOG_FILE}"
}

log_error() {
    local msg="$1"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo -e "${CYAN}[${timestamp}]${NC} ${RED}[✗]${NC} ${msg}" | tee -a "${LOG_FILE}" >&2
}

log_success() {
    local msg="$1"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo -e "${CYAN}[${timestamp}]${NC} ${GREEN}[✔]${NC} ${msg}" | tee -a "${LOG_FILE}"
}

log_debug() {
    local msg="$1"
    if [[ "${DEBUG:-0}" == "1" ]]; then
        local timestamp
        timestamp=$(date '+%Y-%m-%d %H:%M:%S')
        echo -e "${CYAN}[${timestamp}]${NC} ${MAGENTA}[D]${NC} ${msg}" | tee -a "${LOG_FILE}"
    fi
}

# ============================================================================
# ERROR HANDLING AND CLEANUP
# ============================================================================

cleanup() {
    local exit_code=$?

    if [[ -n "${TEMP_DIR}" && -d "${TEMP_DIR}" ]]; then
        log_debug "Cleaning temporary directory: ${TEMP_DIR}"
        rm -rf "${TEMP_DIR}"
    fi

    # Release lock if we hold it
    if [[ -n "${OUTPUT_DIR_LOCK}" && -f "${OUTPUT_DIR_LOCK}" ]]; then
        rm -f "${OUTPUT_DIR_LOCK}"
    fi

    return "${exit_code}"
}

die() {
    local msg="$1"
    local code="${2:-1}"
    log_error "${msg}"
    exit "${code}"
}

# ============================================================================
# TRAP HANDLERS
# ============================================================================

trap cleanup EXIT
trap 'die "Interrupted by user" 130' INT TERM HUP

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

require_command() {
    local cmd="$1"
    if ! command_exists "$cmd"; then
        die "Required command not found: ${cmd}" "${EXIT_MISSING_DEPENDENCY}"
    fi
}

# Create temp directory with security
create_temp_dir() {
    TEMP_DIR="$(mktemp -d)" || die "Failed to create temporary directory" 1
    chmod 700 "${TEMP_DIR}"
    echo "${TEMP_DIR}"
}

# Initialize output directory with proper structure
init_output_dir() {
    if [[ -z "${OUTPUT_DIR}" ]]; then
        OUTPUT_DIR="${SCRIPT_DIR}/results_$(date +%s)"
    fi

    mkdir -p "${OUTPUT_DIR}"

    # Create lock file for preventing concurrent scans
    OUTPUT_DIR_LOCK="${OUTPUT_DIR}/.lock"
    if [[ -f "${OUTPUT_DIR_LOCK}" ]]; then
        local lock_pid
        lock_pid=$(sed -n '1p' "${OUTPUT_DIR_LOCK}" 2>/dev/null || true)
        if [[ "${lock_pid}" =~ ^[0-9]+$ ]] && kill -0 "${lock_pid}" 2>/dev/null; then
            die "Output directory is in use by process ${lock_pid}." "${EXIT_USAGE_ERROR}"
        fi
        # Check if lock is stale (older than 24 hours)
        local lock_age
        lock_age=$(( $(date +%s) - $(stat -c %Y "${OUTPUT_DIR_LOCK}" 2>/dev/null || echo 0) ))
        if [[ ${lock_age} -lt 86400 && ${RESUME} -ne 1 ]]; then
            die "Output directory is locked by another process. Use --resume to continue." "${EXIT_USAGE_ERROR}"
        fi
        log_warn "Stale lock detected (${lock_age}s old), recovering..."
    fi

    echo $$ > "${OUTPUT_DIR_LOCK}"

    # Create directory structure
    STATE_DIR="${OUTPUT_DIR}/state"
    mkdir -p "${STATE_DIR}" "${OUTPUT_DIR}/scope" "${OUTPUT_DIR}/recon" \
            "${OUTPUT_DIR}/artifacts" "${OUTPUT_DIR}/wordlists" "${OUTPUT_DIR}/urls" \
            "${OUTPUT_DIR}/javascript" "${OUTPUT_DIR}/api" "${OUTPUT_DIR}/candidates" \
            "${OUTPUT_DIR}/nuclei" "${OUTPUT_DIR}/logs" "${OUTPUT_DIR}/report"

    LOG_FILE="${OUTPUT_DIR}/logs/main.log"
    MANIFEST_FILE="${OUTPUT_DIR}/manifest.json"
    API_CACHE_DIR="${STATE_DIR}/api_cache"
    SCOPE_CACHE_DIR="${STATE_DIR}/scope_cache"
    mkdir -p "${API_CACHE_DIR}" "${SCOPE_CACHE_DIR}"
    chmod 700 "${API_CACHE_DIR}" "${SCOPE_CACHE_DIR}"

    log_info "Output directory initialized: ${OUTPUT_DIR}"
}

# Generate unique scan ID
generate_scan_id() {
    SCAN_ID="$(date +%Y%m%d_%H%M%S)_$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' ')"
    echo "${SCAN_ID}"
}

# Initialize state files
init_state() {
    if [[ ${RESUME} -eq 1 && -s "${STATE_DIR}/phases.json" ]]; then
        SCAN_ID=$(jq -r '.scan_id // empty' "${STATE_DIR}/phases.json")
        START_TIME=$(jq -r '.start_time // empty' "${STATE_DIR}/phases.json")
        [[ -n "${START_TIME}" ]] || START_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        LAST_ACTIVITY=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        touch "${STATE_DIR}/queue.jsonl" "${STATE_DIR}/seen.txt" "${STATE_DIR}/phase_notes.jsonl"
        return 0
    fi
    START_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    LAST_ACTIVITY="${START_TIME}"

    # Initialize phases.json
    jq -n --arg id "${SCAN_ID}" --arg started "${START_TIME}" \
        '{scan_id:$id,start_time:$started,phases:[]}' > "${STATE_DIR}/phases.json.tmp"
    mv "${STATE_DIR}/phases.json.tmp" "${STATE_DIR}/phases.json"

    # Initialize queue.jsonl and seen.txt
    touch "${STATE_DIR}/queue.jsonl" "${STATE_DIR}/seen.txt" "${STATE_DIR}/phase_notes.jsonl"
}

