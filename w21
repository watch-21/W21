# ============================================================================
# DEPENDENCY CHECKING
# ============================================================================

check_required_dependencies() {
    local missing=()

    for cmd in bash curl jq sort awk sed grep sha256sum file; do
        if ! command_exists "${cmd}"; then
            missing+=("${cmd}")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Missing required dependencies: ${missing[*]}"
        return 1
    fi

    return 0
}

check_optional_dependencies() {
    local optional=(
        subfinder assetfinder amass dnsx puredns shuffledns massdns httpx naabu
        katana gau waymore uro unfurl anew ffuf nuclei interactsh-client subzy
        wafw00f sslscan testssl.sh arjun gf qsreplace LinkFinder SecretFinder
        jsluice pdftotext pdfinfo unzip 7z tar exiftool rg strings
    )

    local missing=()

    for cmd in "${optional[@]}"; do
        if ! command_exists "${cmd}"; then
            missing+=("${cmd}")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_warn "Missing optional tools (reduced coverage): ${missing[*]}"
    fi
}

